<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Copeer</AssemblyName>
    <RootNamespace>Copeer</RootNamespace>
    <ApplicationIcon>Copeer.ico</ApplicationIcon>
    <Version>0.3.2</Version>
    <Product>Copeer</Product>
    <Description>Мультибуфер с историей (Win+V), панель эмодзи и символов (Win+.), скриншоты (Win+Shift+S) и переводчик на Neurooo API (Win+T)</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="emoji\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
