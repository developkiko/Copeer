<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Copeer</AssemblyName>
    <RootNamespace>Copeer</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Copeer</Product>
    <Description>Мультибуфер с историей (Win+V), панель эмодзи и символов (Win+.), скриншоты (Win+Shift+S) и переводчик на Neurooo API (Win+T)</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
